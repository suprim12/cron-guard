<div class="cron-guard">
	<p><a href="{{ cpUrl('utilities/cron-guard') }}">← {{ 'All commands'|t('cron-guard') }}</a></p>
	<h2><code>{{ status.command }}</code></h2>
	<p>
		{% if status.muted %}
			<strong>{{ status.mutedUntil ? 'Muted until {date}.'|t('cron-guard', { date: status.mutedUntil|datetime('short') }) : 'Muted.'|t('cron-guard') }}</strong>
		{% endif %}
		{% if status.message %}<strong>{{ status.message|ucfirst }}.</strong>{% endif %}
		{% if status.interval %}
			{{ 'Runs {every}.'|t('cron-guard', { every: checker.every(status.interval) }) }}
		{% endif %}
		{% if status.usualDuration is not null %}
			{{ 'Usually takes {time}.'|t('cron-guard', { time: checker.duration(status.usualDuration) }) }}
		{% endif %}
	</p>

	<div class="flex" style="margin-bottom: 1.5rem;">
		<form method="post" class="flex">
			{{ csrfInput() }}{{ actionInput('cron-guard/commands/mute') }}{{ redirectInput('utilities/cron-guard?command=' ~ status.id) }}
			{{ hiddenInput('id', status.id) }}{{ hiddenInput('muted', status.muted ? 0 : 1) }}
			{% if not status.muted %}
				<div class="select">
					<select name="for" aria-label="{{ 'Mute for'|t('cron-guard') }}">
						<option value="hour">{{ 'For an hour'|t('cron-guard') }}</option>
						<option value="day">{{ 'For a day'|t('cron-guard') }}</option>
						<option value="week">{{ 'For a week'|t('cron-guard') }}</option>
						<option value="">{{ 'Until I turn it off'|t('cron-guard') }}</option>
					</select>
				</div>
			{% endif %}
			<button type="submit" class="btn">{{ status.muted ? 'Watch again'|t('cron-guard') : 'Mute'|t('cron-guard') }}</button>
		</form>
		<form method="post" onsubmit="return confirm({{ 'Forget this command and its runs? It comes back the next time it runs.'|t('cron-guard')|json_encode }})">
			{{ csrfInput() }}{{ actionInput('cron-guard/commands/forget') }}
			{{ hiddenInput('id', status.id) }}
			<button type="submit" class="btn">{{ 'Forget'|t('cron-guard') }}</button>
		</form>
	</div>

	<div class="cron-guard-table">
		<table class="data fullwidth cron-guard-runs">
			<thead>
				<tr>
					<th scope="col">{{ 'Started'|t('cron-guard') }}</th>
					<th scope="col">{{ 'Took'|t('cron-guard') }}</th>
					<th scope="col">{{ 'Result'|t('cron-guard') }}</th>
					<th scope="col">{{ 'Memory'|t('cron-guard') }}</th>
				</tr>
			</thead>
			<tbody>
				{% for run in runs %}
					<tr>
						<td>{{ run.started|datetime('short') }}</td>
						<td>{{ run.durationMs is not null ? checker.duration(run.durationMs / 1000) : '' }}</td>
						<td>
							{% if run.exitCode is null %}
								<span class="cron-guard-state"><span class="status orange" aria-hidden="true"></span>{{ 'Running, or stopped before it finished'|t('cron-guard') }}</span>
							{% elseif run.exitCode == -1 %}
								<span class="cron-guard-state"><span class="status red" aria-hidden="true"></span>{{ 'Stopped before it finished'|t('cron-guard') }}</span>
								<div class="smalltext light">{{ 'Killed for using too much memory or time, or the server restarted.'|t('cron-guard') }}</div>
							{% elseif run.exitCode == 0 %}
								<span class="cron-guard-state"><span class="status green" aria-hidden="true"></span>{{ 'OK'|t('cron-guard') }}</span>
							{% else %}
								<span class="cron-guard-state"><span class="status red" aria-hidden="true"></span>{{ 'Failed (exit code {code})'|t('cron-guard', { code: run.exitCode }) }}</span>
								{% if run.error %}<div class="smalltext cron-guard-error">{{ run.error }}</div>{% endif %}
								{% set logged = checker.runLog(run) %}
								{% if logged|length %}
									<details class="cron-guard-log">
										<summary class="smalltext">{{ '{count, plural, =1{One error or warning logged} other{# errors and warnings logged}}'|t('cron-guard', { count: logged|length }) }}</summary>
										<ol>
											{% for entry in logged %}
												<li class="smalltext"><span class="cron-guard-log-level {{ entry.level }}">{{ entry.level == 'error' ? 'Error'|t('cron-guard') : 'Warning'|t('cron-guard') }}</span> <span class="light">{{ entry.category }}</span><div class="cron-guard-error">{{ entry.message }}</div></li>
											{% endfor %}
										</ol>
									</details>
								{% endif %}
							{% endif %}
						</td>
						<td class="nowrap">
							{% if run.memory %}
								{{ checker.megabytes(run.memory) }}
								{% if run.memoryLimit ?? null %}<span class="light">{{ 'of {limit}'|t('cron-guard', { limit: checker.megabytes(run.memoryLimit) }) }}</span>{% endif %}
							{% endif %}
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
</div>

{% css %}
.cron-guard-table { overflow-x: auto; margin-bottom: 16px; }
.cron-guard-state { white-space: nowrap; }
.cron-guard-state .status { margin-inline-end: 6px; }
.cron-guard-runs td, .cron-guard-runs th { vertical-align: top; }
.cron-guard-error { white-space: pre-wrap; word-break: break-word; max-width: 60ch; }
.cron-guard-log { margin-top: 6px; }
.cron-guard-log summary { cursor: pointer; }
.cron-guard-log ol { margin: 6px 0 0; padding: 0; list-style: none; }
.cron-guard-log li { padding: 6px 0; border-top: 1px solid var(--hairline-color, rgba(51, 64, 77, 0.1)); }
.cron-guard-log-level { font-weight: 600; }
.cron-guard-log-level.error { color: var(--error-color, #cf1124); }
.cron-guard-log-level.warning { color: var(--warning-color, #b45309); }
{% endcss %}
